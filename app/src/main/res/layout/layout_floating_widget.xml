<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFloatingPill"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_pill"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <!-- Indikator & Kecepatan Unduh (Download) -->
    <TextView
        android:id="@+id/tvDownload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="↓ 0 B/s"
        android:textColor="#4CAF50"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Garis Pemisah Vertikal Tipis -->
    <View
        android:layout_width="1dp"
        android:layout_height="10dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="#33FFFFFF" />

    <!-- Indikator & Kecepatan Unggah (Upload) -->
    <TextView
        android:id="@+id/tvUpload"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="↑ 0 B/s"
        android:textColor="#64B5F6"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Garis Pemisah Vertikal Tipis -->
    <View
        android:layout_width="1dp"
        android:layout_height="10dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="#33FFFFFF" />

    <!-- Indikator Latensi / Ping -->
    <TextView
        android:id="@+id/tvPing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="-- ms"
        android:textColor="#FFB74D"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
