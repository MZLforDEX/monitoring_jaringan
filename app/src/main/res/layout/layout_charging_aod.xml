<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootAod"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true"
    android:keepScreenOn="true">

    <!-- Container Konten AOD yang digeser secara berkala untuk perlindungan anti burn-in OLED -->
    <LinearLayout
        android:id="@+id/containerAodContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- Jam Digital AOD -->
        <TextClock
            android:id="@+id/clockAodTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:fontFamily="sans-serif-light"
            android:textColor="#F0FFFFFF"
            android:textSize="56sp"
            android:textStyle="normal" />

        <!-- Hari & Tanggal -->
        <TextClock
            android:id="@+id/clockAodDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:textColor="#888888"
            android:textSize="13sp" />

        <!-- Separator halus antar jam dan status pengisian -->
        <View
            android:layout_width="48dp"
            android:layout_height="1.5dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#22FFFFFF" />

        <!-- Indikator Watt Kecepatan Cas Utama -->
        <TextView
            android:id="@+id/tvAodWatt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="⚡ 0.0 W"
            android:textColor="#00E5FF"
            android:textSize="40sp"
            android:textStyle="bold" />

        <!-- Persentase Baterai & Sumber Daya -->
        <TextView
            android:id="@+id/tvAodBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="--% • Pengisian Cepat"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Spesifikasi Listrik Detail (Voltase, Arus mA, Suhu) -->
        <TextView
            android:id="@+id/tvAodDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="0.0V • 0mA • 0.0°C"
            android:textColor="#777777"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Petunjuk Keluar Minimalis di Bawah Layar -->
    <TextView
        android:id="@+id/tvAodHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="36dp"
        android:letterSpacing="0.05"
        android:text="Ketuk 2x atau usap untuk keluar"
        android:textColor="#444444"
        android:textSize="11sp" />

</RelativeLayout>
