<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Aplikasi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System &amp; Net Monitor"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Floating HUD v0.1.2 • Super Ringan &amp; Hemat Baterai"
            android:textColor="#888888"
            android:textSize="13sp" />

        <!-- Card Status Layanan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS MONITOR"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_button_stop" />

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Monitor: Nonaktif"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Widget melayang belum berjalan di layar."
                android:textColor="#AAAAAA"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Kartu Peringatan Izin Overlay -->
        <LinearLayout
            android:id="@+id/cardOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Izin Tampil Di Atas Aplikasi Diperlukan"
                android:textColor="#FFB74D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Aplikasi memerlukan izin overlay agar widget floating dapat tampil di atas aplikasi lain."
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_permission"
                android:text="Aktifkan Izin Overlay"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kartu Peringatan Izin Notifikasi -->
        <LinearLayout
            android:id="@+id/cardNotificationPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 Izin Notifikasi Diperlukan"
                android:textColor="#64B5F6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Android 13+ mewajibkan izin notifikasi agar Foreground Service berjalan stabil tanpa dihentikan sistem."
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantNotification"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_permission"
                android:text="Izinkan Notifikasi"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tombol Utama Start / Stop -->
        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_start"
            android:text="Mulai Monitor"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Card Kustomisasi Tampilan Metrik -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KUSTOMISASI METRIK WIDGET"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="Pilih metrik performa yang ingin ditampilkan pada pill overlay:"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <!-- 1. Download -->
            <CheckBox
                android:id="@+id/cbDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kecepatan Unduh (↓ Download)"
                android:textColor="#4CAF50"
                android:textSize="13sp"
                android:checked="true" />

            <!-- 2. Upload -->
            <CheckBox
                android:id="@+id/cbUpload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Kecepatan Unggah (↑ Upload)"
                android:textColor="#64B5F6"
                android:textSize="13sp"
                android:checked="true" />

            <!-- 3. Ping -->
            <CheckBox
                android:id="@+id/cbPing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Latensi Jaringan (ms Ping)"
                android:textColor="#FFB74D"
                android:textSize="13sp"
                android:checked="true" />

            <!-- 4. RAM -->
            <CheckBox
                android:id="@+id/cbRam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Penggunaan Memori (RAM %)"
                android:textColor="#BA68C8"
                android:textSize="13sp"
                android:checked="true" />

            <!-- 5. Suhu -->
            <CheckBox
                android:id="@+id/cbTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Suhu Baterai / Perangkat (°C)"
                android:textColor="#FF8A65"
                android:textSize="13sp"
                android:checked="true" />

        </LinearLayout>

        <!-- Informasi Efisiensi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EFISIENSI &amp; PRIVASI"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• Otomatis jeda komputasi 100% saat layar mati\n• Membaca RAM via MemoryInfo reusable (Zero GC alloc)\n• Membaca Suhu via cached sticky broadcast\n• 100% aman tanpa root &amp; tanpa akses data pribadi"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
