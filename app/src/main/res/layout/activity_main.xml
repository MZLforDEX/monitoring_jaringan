<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Aplikasi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System &amp; Net Monitor"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Floating HUD v0.3.0 • Game Booster &amp; Custom Widget"
            android:textColor="#888888"
            android:textSize="13sp" />

        <!-- 1. Card Status Layanan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STATUS MONITOR"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_button_stop" />

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Monitor: Nonaktif"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Widget melayang belum berjalan di layar."
                android:textColor="#AAAAAA"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Kartu Peringatan Izin Overlay -->
        <LinearLayout
            android:id="@+id/cardOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Izin Tampil Di Atas Aplikasi Diperlukan"
                android:textColor="#FFB74D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Aplikasi memerlukan izin overlay agar widget floating dapat tampil di atas aplikasi lain."
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantOverlay"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_permission"
                android:text="Aktifkan Izin Overlay"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kartu Peringatan Izin Notifikasi -->
        <LinearLayout
            android:id="@+id/cardNotificationPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 Izin Notifikasi Diperlukan"
                android:textColor="#64B5F6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Android 13+ mewajibkan izin notifikasi agar Foreground Service berjalan stabil tanpa dihentikan sistem."
                android:textColor="#CCCCCC"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantNotification"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_permission"
                android:text="Izinkan Notifikasi"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tombol Utama Start / Stop -->
        <Button
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_start"
            android:text="Mulai Monitor"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 2. Card GAME BOOSTER (FITUR BARU) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚀 GAME BOOSTER (ANTI-LAG)"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2600E5FF"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="ULTRA-RINGAN"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pangkas cache &amp; proses memori latar belakang yang menumpuk serta stabilkan jaringan untuk gameplay mulus tanpa lag."
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

            <!-- Meter Penggunaan RAM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Penggunaan RAM"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvRamStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Membaca RAM..."
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbRamUsage"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progress="65"
                    android:progressDrawable="@drawable/bg_ram_progress" />
            </LinearLayout>

            <!-- Tombol Aksi Game Boost -->
            <Button
                android:id="@+id/btnGameBoost"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_boost"
                android:text="🚀 Boost Performa Game Sekarang"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Banner Hasil Game Boost -->
            <LinearLayout
                android:id="@+id/layoutBoostResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_boost_result"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvBoostResultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Optimasi Game Berhasil!"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBoostResultDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="+240 MB RAM dibebaskan • Latensi stabil"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="⚡ 0% Beban Latar Belakang: Hanya berjalan saat tombol ditekan (on-demand), tanpa daemon yang membebani CPU/baterai."
                android:textColor="#777777"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. Card MONITOR PENGISIAN DAYA & WATT (FITUR BARU) -->
        <LinearLayout
            android:id="@+id/cardChargingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ MONITOR PENGISIAN DAYA (WATT)"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChargingBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2600E5FF"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="REAL-TIME"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvChargingWattMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- W"
                    android:textColor="#00E5FF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvChargingStatusMain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Memeriksa status pengisian..."
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChargingDetailsMain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tegangan: --V • Arus: --mA"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Kecepatan pengisian dihitung akurat dari tegangan (V) &amp; arus (mA) baterai aktual per detik."
                android:textColor="#777777"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4. Card KUSTOMISASI TAMPILAN WIDGET -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 KUSTOMISASI WIDGET MELAYANG"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kustomisasi transparansi, skema warna teks, ukuran font, dan tata letak HUD:"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />

            <!-- LIVE PREVIEW CONTAINER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#0A0A0A"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="LIVE PREVIEW WIDGET"
                    android:textColor="#666666"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Mockup Floating Widget -->
                <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/previewRootWidget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/previewTvDownload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="↓ 2.4 MB/s"
                            android:textColor="#4CAF50"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />

                        <View
                            android:id="@+id/previewSepDownload"
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="#33FFFFFF" />

                        <TextView
                            android:id="@+id/previewTvUpload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="↑ 180 KB/s"
                            android:textColor="#64B5F6"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />

                        <View
                            android:id="@+id/previewSepUpload"
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="#33FFFFFF" />

                        <TextView
                            android:id="@+id/previewTvPing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="28ms"
                            android:textColor="#FFB74D"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />

                        <View
                            android:id="@+id/previewSepPing"
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="#33FFFFFF" />

                        <TextView
                            android:id="@+id/previewTvFps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="60 FPS"
                            android:textColor="#FFD54F"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />

                        <View
                            android:id="@+id/previewSepFps"
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="#33FFFFFF" />

                        <TextView
                            android:id="@+id/previewTvRam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="RAM 58%"
                            android:textColor="#BA68C8"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />

                        <View
                            android:id="@+id/previewSepRam"
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="#33FFFFFF" />

                        <TextView
                            android:id="@+id/previewTvTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="34.2°C"
                            android:textColor="#FF8A65"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium" />

                        <View
                            android:id="@+id/previewSepTemp"
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="#33FFFFFF" />

                        <TextView
                            android:id="@+id/previewTvWatt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="⚡ 27.5W"
                            android:textColor="#00E5FF"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold" />

                        <View
                            android:id="@+id/previewSepBoost"
                            android:layout_width="1dp"
                            android:layout_height="10dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="#33FFFFFF" />

                        <TextView
                            android:id="@+id/previewBtnBoost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="⚡ BOOST"
                            android:textColor="#FFD54F"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-black"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp" />

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- A. Gaya Latar Belakang (Transparansi) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Gaya Latar Belakang (Background)"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgBgStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbBgSemiTransparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Semi-Transparan Gelap (Default 80%)"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbBgTransparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Transparan Penuh (Bening / 100% Transparan)"
                    android:textColor="#00E5FF"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbBgSolidBlack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Solid Hitam Pekat (100% Gelap Kontras)"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbBgGlassNeon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kaca Cyber Neon (Border Biru Menyala)"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- B. Skema Warna Teks (Berwarna vs Polos) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Skema Warna Teks (Warna vs Polos)"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTextStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbTextColored"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Berwarna-warni (Aksen Neon per Metrik)"
                    android:textColor="#81C784"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbTextPlainWhite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Polos Putih Bersih (Monokrom Minimalis)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbTextMatrixGreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Polos Hijau Matrix (Terminal Hacker)"
                    android:textColor="#00FF66"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbTextCyanCyber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Polos Cyan Cyber (Esport Gaming)"
                    android:textColor="#00E5FF"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- C. Ukuran Font Teks -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ukuran Font Widget"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTextSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSizeSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kecil"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbSizeNormal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Standar"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbSizeLarge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Besar"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- D. Bentuk Sudut Widget -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bentuk Sudut Widget"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgCornerRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCornerPill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kapsul Bulat (Pill)"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/rbCornerRounded"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kotak Membulat"
                    android:textColor="#CCCCCC"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- E. Tombol Quick Boost di Widget -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Fitur Interaktif Widget"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbQuickBoost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tampilkan Tombol Quick Boost ⚡ di Widget Floating"
                android:textColor="#00E5FF"
                android:textSize="12sp" />

            <!-- F. Pilihan Metrik yang Dimunculkan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Pilihan Metrik Ditampilkan"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 1. Download -->
            <CheckBox
                android:id="@+id/cbDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Kecepatan Unduh (↓ Download)"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:checked="true" />

            <!-- 2. Upload -->
            <CheckBox
                android:id="@+id/cbUpload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kecepatan Unggah (↑ Upload)"
                android:textColor="#64B5F6"
                android:textSize="12sp"
                android:checked="true" />

            <!-- 3. Ping -->
            <CheckBox
                android:id="@+id/cbPing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Latensi Jaringan (ms Ping)"
                android:textColor="#FFB74D"
                android:textSize="12sp"
                android:checked="true" />

            <!-- 4. Frame Rate / Refresh Rate -->
            <CheckBox
                android:id="@+id/cbFps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Frame Rate / Refresh Rate (FPS / Hz)"
                android:textColor="#FFD54F"
                android:textSize="12sp"
                android:checked="true" />

            <!-- 5. RAM -->
            <CheckBox
                android:id="@+id/cbRam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Penggunaan Memori (RAM %)"
                android:textColor="#BA68C8"
                android:textSize="12sp"
                android:checked="true" />

            <!-- 6. Suhu -->
            <CheckBox
                android:id="@+id/cbTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Suhu Baterai / Perangkat (°C)"
                android:textColor="#FF8A65"
                android:textSize="12sp"
                android:checked="true" />

            <!-- 7. Daya Pengisian (Watt Cas) -->
            <CheckBox
                android:id="@+id/cbWatt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kecepatan Cas (⚡ Watt Daya Baterai)"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:checked="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="4dp"
                android:text="*Otomatis muncul di widget saat HP sedang di-cas"
                android:textColor="#888888"
                android:textSize="11sp" />

            <!-- G. Layar Kunci & Always-On Display (AOD) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Layar Kunci &amp; Always-On Display (AOD)"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 1. Tampilkan di Layar Kunci -->
            <CheckBox
                android:id="@+id/cbShowLockscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tampilkan Widget di Layar Kunci (Lockscreen)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:checked="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="Widget floating tetap dapat dilihat saat layar terkunci."
                android:textColor="#888888"
                android:textSize="11sp" />

            <!-- 2. Mode Layar AOD Saat Di-cas -->
            <CheckBox
                android:id="@+id/cbChargingAod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mode Layar AOD Saat Di-cas (OLED Pure Black)"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:checked="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="Menampilkan jam &amp; watt di layar hitam pekat saat dicas &amp; layar mati (hemat baterai &amp; anti burn-in)."
                android:textColor="#888888"
                android:textSize="11sp" />

            <!-- Tombol Uji Coba Tampilan AOD -->
            <Button
                android:id="@+id/btnTestAod"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_button_permission"
                android:text="⚡ Uji Coba Tampilan Layar AOD"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 4. Informasi Mode FPS & Refresh Rate -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INFORMASI MODE FPS &amp; REFRESH RATE"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFpsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Mode Aktif: Display Refresh Rate (Hz)"
                android:textColor="#FFD54F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShizukuStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Status Shizuku: Memeriksa..."
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRequestShizuku"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_start"
                android:text="Minta Izin Shizuku (Rekomendasi)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Shizuku memberikan hak shell ADB langsung di perangkat tanpa root, melewati batasan SELinux untuk mengukur True Game FPS secara akurat.\n\nAlternatif via ADB manual di PC:"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/tvAdbCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#1E1E1E"
                android:padding="10dp"
                android:text="adb shell pm grant com.example.netmonitor android.permission.DUMP"
                android:textColor="#81C784"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="(Ketuk teks kode di atas untuk menyalin perintah ADB)"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 5. Informasi Efisiensi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EFISIENSI &amp; PRIVASI"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="• Otomatis jeda komputasi 100% saat layar mati\n• Game Booster on-demand tanpa background drain\n• Membaca RAM via MemoryInfo reusable (Zero GC alloc)\n• Membaca Suhu via cached sticky broadcast\n• 100% aman tanpa root &amp; tanpa akses data pribadi"
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- 6. Tentang Aplikasi (About) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TENTANG APLIKASI"
                android:textColor="#888888"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Network Monitor (Floating HUD)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAboutVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Versi: v0.3.0 (Build 11) • Lisensi: MIT"
                android:textColor="#81C784"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Aplikasi utilitas open-source untuk pemantauan throughput data, latensi, in-game FPS, konsumsi RAM, suhu perangkat, Game Booster anti-lag, dan kustomisasi widget melayang secara real-time langsung di layar."
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

            <Button
                android:id="@+id/btnOpenGitHub"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_permission"
                android:text="Kunjungi Repositori GitHub"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
